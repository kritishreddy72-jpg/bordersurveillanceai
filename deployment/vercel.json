{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "^/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "^/presentation",
      "dest": "/presentation.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}
