{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/frontend/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "^/presentation",
      "dest": "/frontend/presentation.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
